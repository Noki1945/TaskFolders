#pragma code_page(65001)
#include <windows.h>
#include "ids.h"
EDITOR DIALOGEX 0,0,398,307
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TaskFolders · Настройки"
FONT 10,"Segoe UI"
BEGIN
 AUTORADIOBUTTON "Музыкальные клавиши",MEDIA_TAB,186,7,130,15,BS_PUSHLIKE | WS_TABSTOP
 AUTOCHECKBOX "Запускать TaskFolders при входе в Windows",AUTOSTART,10,260,290,15
 PUSHBUTTON "Удалить все",REMOVE_ALL,78,219,55,15
 AUTORADIOBUTTON "Папки",FOLDER_TAB,10,7,65,15,WS_GROUP | BS_PUSHLIKE | WS_TABSTOP
 AUTORADIOBUTTON "Устройства и заряд",DEVICE_TAB,78,7,105,15,BS_PUSHLIKE | WS_TABSTOP
 LTEXT "Папки",GROUP_LABEL,10,32,110,12
 LISTBOX GROUPS,10,47,115,116,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER | LBS_NOINTEGRALHEIGHT
 LTEXT "Название папки",NAME_LABEL,10,168,110,11
 EDITTEXT NAMEBOX,10,181,115,15,ES_AUTOHSCROLL
 PUSHBUTTON "Создать",NEWGROUP,10,201,52,15
 PUSHBUTTON "Переименовать",RENAMEGROUP,64,201,67,15
 PUSHBUTTON "Удалить папку",DROPGROUP,10,219,65,15
 LTEXT "Приложения",APPS_LABEL,140,32,215,12
 LISTBOX APPS,140,47,228,134,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER | LBS_NOINTEGRALHEIGHT
 PUSHBUTTON "Добавить файл…",ADDAPP,140,188,80,17
 PUSHBUTTON "Убрать",DROPAPP,225,188,54,17
 LTEXT "Можно перетащить EXE или ярлык в это окно.",DROP_HINT,140,209,228,12
 AUTOCHECKBOX "Подпись под папкой",SHOWLABEL,10,227,125,15
 AUTOCHECKBOX "Сетка 4×4 (16 на страницу)",DENSEGRID,140,224,170,15
 DEFPUSHBUTTON "Сохранить",IDOK,245,279,60,17
 PUSHBUTTON "Отмена",IDCANCEL,309,279,59,17
 COMBOBOX BACKGROUND,10,247,180,65,CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
 PUSHBUTTON "Выбрать изображение…",BACKGROUND_FILE,195,246,108,17
 PUSHBUTTON "Обновить заряд",DEVICE_REFRESH,132,279,92,17
 CONTROL "",DEVICE_TREE,"SysTreeView32",WS_TABSTOP | WS_BORDER | 0x0027,10,33,378,200
 LTEXT "",DEVICE_STATUS,10,239,372,29
 PUSHBUTTON "Применить выбранное",DEVICE_ACTION,10,279,118,17
END
