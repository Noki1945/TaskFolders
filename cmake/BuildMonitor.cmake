file(REMOVE "src/mouse_indicator.h")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${ARCHIVE}" RESULT_VARIABLE err)
if(err)
  message(FATAL_ERROR "Could not extract monitor source")
endif()
get_filename_component(parent "." REALPATH)
get_filename_component(parent "${parent}" DIRECTORY)
set(ENV{GIT_CEILING_DIRECTORIES} "${parent}")
execute_process(COMMAND "${GIT}" apply --no-index --whitespace=nowarn "${PATCH}" RESULT_VARIABLE err)
file(STRINGS "src/main.cpp" bridge REGEX "const UINT settingsRequest=")
if(err OR NOT bridge)
  message(FATAL_ERROR "Could not apply TaskFolders monitor patch")
endif()
set(ENV{PATH} "${BIN};$ENV{PATH}")
execute_process(COMMAND cmd.exe /d /c build.bat 1.1.0 dev RESULT_VARIABLE err)
if(err)
  message(FATAL_ERROR "BatteryHub compilation failed")
endif()
