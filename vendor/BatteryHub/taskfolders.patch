diff --git a/src/mouse_indicator.h b/src/mouse_indicator.h
new file mode 100644
index 0000000..a73820f
--- /dev/null
+++ b/src/mouse_indicator.h
@@ -0,0 +1,16 @@
+#pragma once
+namespace mouse_indicator {
+enum class Band { normal, yellow, red };
+constexpr Band band(int pct) {
+    if(pct<0 || pct>=20) return Band::normal;
+    return pct<5 ? Band::red : Band::yellow;
+}
+static_assert(band(-1)==Band::normal && band(0)==Band::red && band(4)==Band::red &&
+              band(5)==Band::yellow && band(19)==Band::yellow && band(20)==Band::normal);
+template<class Color>
+Color color(Band level, Color normal, bool light) {
+    if(level==Band::red) return light ? Color{198,24,43} : Color{255,70,80};
+    if(level==Band::yellow) return light ? Color{166,125,0} : Color{255,211,48};
+    return normal;
+}
+}
